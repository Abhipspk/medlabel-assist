{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteAuditArchiveOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:PutObjectRetention"],
      "Resource": "arn:aws:s3:::medlabel-audit-archive/audit/*"
    },
    {
      "Sid": "NeverDeleteOrChangePolicy",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:PutBucketPolicy"],
      "Resource": ["arn:aws:s3:::medlabel-audit-archive", "arn:aws:s3:::medlabel-audit-archive/*"]
    }
  ]
}